
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_SITE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_VISION_MODEL=gpt-4o-mini
# Optional tutorial-only override. Falls back to OPENAI_MODEL, then gpt-5-mini.
OPENAI_TUTORIAL_MODEL=
# Vision detail for /api/generate-tutorial: high | auto | low (default high).
OPENAI_TUTORIAL_IMAGE_DETAIL=high

# Stage AI refinement (default off for MVP — deterministic master-derived targets).
# Use NEXT_PUBLIC_ so client and server agree; ENABLE_AI_STAGE_REFINEMENT is a server alias.
NEXT_PUBLIC_ENABLE_AI_STAGE_REFINEMENT=false
ENABLE_AI_STAGE_REFINEMENT=false

# Stage AI retries (0 while testing). Master retries use MASTER_GEN_MAX_RETRIES (default 1).
STAGE_GEN_MAX_RETRIES=0

# Paid image generation stays off unless explicitly switched on outside this branch.
ENABLE_STAGE_IMAGE_GEN=false
GEN_QUOTA_TUTORIALS_PER_DAY=0
GEN_QUOTA_IMAGES_PER_DAY=0
GEN_QUOTA_MAX_CONCURRENT=0
