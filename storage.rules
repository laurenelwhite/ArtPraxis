rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Stage demonstration PNGs (nested under …/stages/).
    // Explicit match — recursive {allPaths=**} alone has historically missed
    // this path shape when only a flat {fileName} rule was deployed.
    match /users/{uid}/projects/{projectId}/stages/{fileName} {
      allow read: if request.auth != null
                  && request.auth.uid == uid;

      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource != null
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Other project-owned assets at any depth (reference image, master siblings,
    // future exports/offline). Owner-only; images + PDF; 25MB cap.
    match /users/{uid}/projects/{projectId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource != null
                   && request.resource.size < 25 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
    }
  }
}
