rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  // All project-owned assets, at any depth under the owner's project:
  //   …/projects/{id}/{file}                    (reference image, thumbnail)
  //   …/projects/{id}/stages/{stageId}.png      (pencil sketch + 5 painting stages)
  //   …/projects/{id}/exports/{file}.pdf        (future lesson PDF export)
  //   …/projects/{id}/offline/…                 (future offline assets)
  // The {allPaths=**} recursive match covers every current and future nested
  // folder while staying strictly owner-only and size-capped. Writes are limited
  // to a tight content-type allowlist (images + PDF) so the path cannot be used
  // to store arbitrary files.
  match /users/{uid}/projects/{projectId}/{allPaths=**} {
   allow read: if request.auth != null && request.auth.uid == uid;
   allow write: if request.auth != null
     && request.auth.uid == uid
     && request.resource.size < 25 * 1024 * 1024
     && (request.resource.contentType.matches('image/.*')
         || request.resource.contentType == 'application/pdf');
  }
 }
}
