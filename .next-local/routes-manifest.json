{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/studio/lessons/[id]",
      "regex": "^/studio/lessons/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/studio/lessons/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/icon.svg",
      "regex": "^/icon\\.svg(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/icon\\.svg(?:/)?$"
    },
    {
      "page": "/studio",
      "regex": "^/studio(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/studio(?:/)?$"
    },
    {
      "page": "/studio/coach",
      "regex": "^/studio/coach(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/studio/coach(?:/)?$"
    },
    {
      "page": "/studio/collections",
      "regex": "^/studio/collections(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/studio/collections(?:/)?$"
    },
    {
      "page": "/studio/favorites",
      "regex": "^/studio/favorites(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/studio/favorites(?:/)?$"
    },
    {
      "page": "/studio/new",
      "regex": "^/studio/new(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/studio/new(?:/)?$"
    },
    {
      "page": "/studio/practice",
      "regex": "^/studio/practice(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/studio/practice(?:/)?$"
    },
    {
      "page": "/studio/search",
      "regex": "^/studio/search(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/studio/search(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}